#!/bin/bash

screenshot_dir="/home/lukas/screenshots"
playlist=$(mktemp)

# Find the 10 newest screenshots, ordered newest first
find "$screenshot_dir" -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
    -printf '%T@ %p\n' |
    sort -rn |
    head -n 10 |
    cut -d' ' -f2- > "$playlist"

if [[ ! -s "$playlist" ]]; then
    echo "No screenshots found."
    rm -f "$playlist"
    exit 1
fi

# Open the playlist in mpv, starting with the newest screenshot
mpv --playlist="$playlist"

rm -f "$playlist"
